{
  "name": "defer",
  "version": "1.0.0",
  "description": "MDIA — assistant IA pour la gestion administrative des artisans et des foyers",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "stripe:setup": "node --env-file-if-exists=.env scripts/stripe-setup.js",
    "artisans": "node scripts/artisans-btp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doriandefer-ops/Defer.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/doriandefer-ops/Defer/issues"
  },
  "homepage": "https://github.com/doriandefer-ops/Defer#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "stripe": "^23.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
