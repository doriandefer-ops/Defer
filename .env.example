# Port du serveur web
PORT=3000

# Clé API Anthropic (obligatoire pour l'assistant IA)
ANTHROPIC_API_KEY=
# Modèle Claude utilisé par l'assistant
CLAUDE_MODEL=claude-opus-5-5

# Stripe (facultatif) — sans clé, le site fonctionne en "mode démo" :
# le changement d'abonnement est appliqué immédiatement, sans paiement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOYER=
STRIPE_PRICE_ARTISAN=

# URL publique du site (utilisée pour les redirections Stripe)
PUBLIC_URL=http://localhost:3000

# Emplacement de la base SQLite
DATABASE_PATH=./data/defer.db
