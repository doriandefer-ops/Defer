# Port du serveur web
PORT=3000

# Clé API Anthropic (obligatoire pour l'assistant IA)
ANTHROPIC_API_KEY=
# Modèle Claude utilisé par l'assistant
CLAUDE_MODEL=claude-opus-5-5

# Stripe — sans clé, le site fonctionne en "mode démo" en local (changement d'offre immédiat, sans paiement).
# En production (NODE_ENV=production), sans clé, les offres payantes sont désactivées.
# Les valeurs ci-dessous sont générées par : npm run stripe:setup
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOYER=
STRIPE_PRICE_ARTISAN=

# URL publique du site (utilisée pour les redirections Stripe)
PUBLIC_URL=http://localhost:3000

# Emplacement de la base SQLite
DATABASE_PATH=./data/defer.db

# Mettre "production" sur le serveur en ligne
NODE_ENV=
# Forcer le mode démo des paiements en production (préproduction uniquement)
ALLOW_DEMO_BILLING=false
